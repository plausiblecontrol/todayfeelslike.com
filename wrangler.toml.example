name = "today-feels-like"
main = "src/index.js"
compatibility_date = "2024-03-09"

[triggers]
crons = ["0 15 * * *"]

[ai]
binding = "AI"

[[routes]]
pattern = "todayfeelslike.com"
custom_domain = true
zone_name = "todayfeelslike.com"

[[kv_namespaces]]
binding = "CONTENT_KV"
id = "{{ op://today-feels-like/KV_NAMESPACE_ID }}"
